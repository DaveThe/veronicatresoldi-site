---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | where_exp: "p", "p.noindex != true" | sort: "url" %}
{%- for p in pages %}
  <url>
    <loc>{{ site.url }}{{ p.url | replace: 'index.html', '' | replace: '.html', '' }}</loc>
{%- if p.updated %}
    <lastmod>{{ p.updated }}</lastmod>
{%- endif %}
  </url>
{%- endfor %}
</urlset>
